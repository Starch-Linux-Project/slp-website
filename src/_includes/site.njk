<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="{{ (description or article.description or wiki.home.description) | escape }}">
  <meta name="theme-color" content="#05070b">
  <title>{{ (title or article.title or wiki.home.title) | escape }} — Starch Linux Project</title>
  <link rel="canonical" href="https://starchlinuxproject.org{{ page.url }}">
  <link rel="stylesheet" href="/css/main.css">
  <link rel="stylesheet" href="/css/wiki.css">
  <script src="/js/main.js" defer></script>
</head>
<body>
<a class="skip-link" href="#main">Skip to content</a>
<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="/" aria-label="Starch Linux Project home"><img class="brand-logo" src="/starchlinux_v2.png" alt="" width="48" height="48"> <span>Starch Linux Project</span></a>
    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-navigation">Menu</button>
    <nav class="nav-links" id="site-navigation" aria-label="Main navigation"><a href="/">Home</a><a href="/download/">Download</a><a href="/wiki/"{% if page.url == '/wiki/' %} aria-current="page"{% elif article %} aria-current="true"{% endif %}>Wiki</a><a href="/community/">Community</a><a href="/extras/">Extras</a></nav>
  </div>
</header>
<main id="main" class="container">
  {{ content | safe }}
</main>
<footer class="site-footer">
  <div class="container">
    <div class="footer-top">
      <div><a class="brand" href="/"><img class="brand-logo" src="/starchlinux_v2.png" alt="" width="48" height="48"> <span>Starch Linux Project</span></a><p>The home of the Starch Linux Project.</p></div>
      <nav class="footer-links" aria-label="Footer navigation"><a href="/wiki/">Wiki</a><a href="/community/">Community</a></nav>
    </div>
    <div class="footer-bottom"><span>Starch Linux Project</span><a href="#main">Back to top ↑</a></div>
  </div>
</footer>
</body>
</html>
